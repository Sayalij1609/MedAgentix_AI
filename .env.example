# ============================================================
# MedAgentix AI -- Local Environment Configuration Template
# ============================================================
# Copy this file to a new file named '.env' and fill in your actual credentials.
# Do NOT commit '.env' to version control (Git).

# --- Database Configurations ---
# Individual credentials:
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medagentix_db

# Or use a single unified connection URI (if set, this overrides DB_* fields above):
# DATABASE_URL=postgresql://your_postgres_username:your_postgres_password@localhost:5432/medagentix_db

# --- Security Settings ---
# Generate strong keys for production environments:
SECRET_KEY=your_flask_session_secret_key
JWT_SECRET_KEY=your_jwt_signature_secret_key
